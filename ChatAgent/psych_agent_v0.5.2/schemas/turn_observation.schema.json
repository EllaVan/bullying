{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "covered",
              "partial",
              "ambiguous",
              "declined",
              "not_applicable"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "reference_frame": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "hypothetical_intent",
              "habitual_self_report",
              "real_event_self_report",
              "general_belief",
              "task_performance",
              "unclear"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "self",
              "other",
              "unclear"
            ]
          },
          "context_turn_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot_id": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "slot_id",
                "value",
                "quote"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "rule_id",
                "quote",
                "rationale"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "unit_id",
          "status",
          "quote",
          "reference_frame",
          "subject",
          "context_turn_ids",
          "slots",
          "evidence",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "background": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "F01",
              "F02",
              "F03",
              "F04"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reference_frame": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "hypothetical_intent",
              "habitual_self_report",
              "real_event_self_report",
              "general_belief",
              "task_performance",
              "unclear"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "self",
              "other",
              "unclear"
            ]
          }
        },
        "required": [
          "item_id",
          "quote",
          "description",
          "reference_frame",
          "subject"
        ],
        "additionalProperties": false
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "self",
              "other",
              "unclear"
            ]
          },
          "reference_frame": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "real_event_self_report"
            ]
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "role",
                    "form",
                    "frequency",
                    "recency",
                    "current_status",
                    "adult_trust"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "field",
                "value",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "quote",
          "subject",
          "reference_frame",
          "details"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "turn_id",
    "observations",
    "background"
  ],
  "additionalProperties": false
}
