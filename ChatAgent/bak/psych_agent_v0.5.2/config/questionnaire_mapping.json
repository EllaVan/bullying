      "context_only": false,
      "operational_mapping_status": "needs_review",
      "response_options": null,
      "score_rule": null
    },
    {
      "item_id": "C03",
      "section": "C",
      "text": "让别人知道“不要轻易惹我”可以减少麻烦",
      "source_evidence": "威慑认知；通过强势建立位置",
      "source_evidence_category": "支配认知",
      "variable_ids": [
        "PV06"
