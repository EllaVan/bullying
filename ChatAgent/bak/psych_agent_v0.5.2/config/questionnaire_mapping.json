      "context_only": false,
      "operational_mapping_status": "needs_review",
      "response_options": null,
      "score_rule": null
    },
    {
      "item_id": "C02",
      "section": "C",
      "text": "当别人明显不听我的意见时，我会觉得难接受",
      "source_evidence": "控制需求；无法接受拒绝",
