{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "hypothetical_intent",
              "self_report",
              "third_party_report",
              "general_belief",
              "unclear"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "self",
              "other",
              "unclear"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rule_id",
          "turn_id",
          "quote",
          "source_kind",
          "subject",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variable_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "variable_id",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "case_id",
    "evidence",
    "gaps"
  ],
  "additionalProperties": false
}
